{
  "IsEncrypted": false,
  "Values": {
    "FUNCTIONS_WORKER_RUNTIME": "python",
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "AzureWebJobsStorage__accountName": "",

    "AZURE_STORAGE_CONNECTION_STRING": "<your-storage-connection-string-or-remove-and-set-STORAGE_ACCOUNT_NAME>",
    "STORAGE_ACCOUNT_NAME": "",

    "_note_BLOB_INPUT_CONTAINER": "Must be set here so the Functions HOST can bind the blob trigger path",
    "BLOB_INPUT_CONTAINER":    "input-json",
    "BLOB_TEMPLATE_CONTAINER": "templates-ppt",
    "BLOB_TEMPLATE_NAME":      "AgendaTemplate.pptx",
    "BLOB_OUTPUT_CONTAINER":   "output-agenda_ppt",

    "SAS_EXPIRY_HOURS":        "24",
    "MAX_BULLETS_PER_SLIDE":   "4",
    "_note_PPTX_SCRIPTS_DIR":  "Linux/Azure default shown. Windows local dev: use absolute path e.g. C:\\\\path\\\\to\\\\scripts",
    "PPTX_SCRIPTS_DIR":        "/home/site/wwwroot/scripts"
  }
}
