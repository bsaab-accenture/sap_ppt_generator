    "BLOB_OUTPUT_CONTAINER":   "output-pptx",

    "SAS_EXPIRY_HOURS":        "24",
    "MAX_BULLETS_PER_SLIDE":   "4",
    "PPTX_SCRIPTS_DIR":        "/home/site/wwwroot/scripts"
  }
}
